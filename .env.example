# Google Gemini API Key (free tier via https://aistudio.google.com/apikey)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key — recommended (free, higher limits via https://console.groq.com)
VITE_GROQ_API_KEY=your_groq_api_key_here

# Updater Testing Configuration
# Point to a local server (e.g., http://localhost:5000) to test without GitHub
# UPDATER_FEED_URL=http://localhost:5000
# GitHub Token to support Draft/Private releases
# GH_TOKEN=your_github_token_here
# Set to 'true' to allow testing with Prerelease/Draft versions
# UPDATER_ALLOW_PRERELEASE=false
